#!/usr/bin/env python3
"""hamtag - Generate name badge labels for thermal printers.

Looks up HAM callsigns in a hamdat SQLite database and produces ZPL (Zebra
printers) or TSPL (TSC-compatible printers, e.g. the MUNBYN ITPP130B)
ready to send to a thermal label printer.

Label format: 4"x6" stock rendered as a single PIL bitmap, rotated 90°
clockwise for landscape orientation (6" wide, 4" tall when worn).
The same PIL image is used for both the print output and the GUI preview.

Author: Matt Hoskins, K2TTA
"""

import argparse
import csv
import os
import random
import shutil
import socket
import sqlite3
import sys
import textwrap
from pathlib import Path

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    sys.exit("Install Pillow:  pip install Pillow")

DB_DEFAULT = Path.home() / ".hamdat" / "hamdat.db"
DB_ENV     = "HAMDAT_DB"

# TTF fonts searched in order.  Bold weights preferred; slashed-zero fonts first.
# sudo apt install fonts-noto   fonts-firacode   fonts-hack
# Layout proportions (all sizes in inches) per label stock.
# 4x6: physical 4"×6" portrait on the roll; rendered landscape, rotated 90° CW for ZPL.
# 4x2: physical 4"×2"; rendered as-is, no rotation needed.
_LABEL_CFG = {
    "4x6": dict(
        lw_in=6,   lh_in=4,   rotate=True,
        mt=0.17,   mb=0.17,   ms=0.20,  gap=0.07, div=4,
        banner_h=0.24, first_name_h=0.48, name_h=0.16, name_gap=0.03,
        loc_h=0.16, note_h=0.27, call_pad=0.05,
    ),
    "4x2": dict(
        lw_in=4,   lh_in=2,   rotate=False,
        mt=0.13,   mb=0.09,   ms=0.12,  gap=0.04, div=3,
        banner_h=0.15, first_name_h=0.26, name_h=0.08, name_gap=0.015,
        loc_h=0.08, note_h=0.14, call_pad=0.03,
    ),
}

_FONT_CANDIDATES = [
    "/usr/share/fonts/truetype/noto/NotoSansMono-Bold.ttf",
    "/usr/share/fonts/truetype/firacode/FiraCode-Bold.ttf",
    "/usr/share/fonts/truetype/hack/Hack-Bold.ttf",
    "/usr/share/fonts/truetype/hack/Hack-Regular.ttf",
    "/usr/share/fonts/truetype/inconsolata/Inconsolata-Bold.ttf",
    "/usr/share/fonts/truetype/inconsolata/Inconsolata-Regular.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationMono-Bold.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf",
    "/usr/share/fonts/truetype/noto/NotoMono-Regular.ttf",
    "/usr/share/fonts/truetype/ubuntu/UbuntuMono-B.ttf",
]


def find_font(custom_path=None):
    """Return a path to a usable TTF font, or exit with a helpful message."""
    if custom_path:
        if not Path(custom_path).exists():
            sys.exit(f"Font not found: {custom_path}")
        return custom_path
    for path in _FONT_CANDIDATES:
        if Path(path).exists():
            return path
    sys.exit(
        "No suitable font found. Install one with:\n"
        "  sudo apt install fonts-hack        (recommended — has slashed zero)\n"
        "  sudo apt install fonts-dejavu-core (fallback)\n"
        "Or specify a font with --font /path/to/font.ttf"
    )


# A callsign can have several license_header rows (one per past holder), and
# row order is just FCC file load order.  Prefer the active license, then the
# most recent last_action_date (stored MM/DD/YYYY, so reorder to YYYYMMDD to
# sort chronologically), then id as a final tiebreak.
_LOOKUP_SQL = """
    SELECT e.first_name, e.mi, e.last_name, e.entity_name, e.city, e.state
      FROM license_header h
      JOIN entity e ON e.unique_system_identifier = h.unique_system_identifier
     WHERE h.call_sign = ?
       AND (e.entity_type = 'L' OR e.entity_type = '')
     ORDER BY CASE WHEN h.license_status = 'A' THEN 0 ELSE 1 END,
              substr(h.last_action_date, 7, 4) || substr(h.last_action_date, 1, 2)
                  || substr(h.last_action_date, 4, 2) DESC,
              h.id DESC,
              CASE WHEN e.entity_type = 'L' THEN 0 ELSE 1 END
     LIMIT 1
"""


def _open_db(db_path):
    """Open the hamdat DB read-only (never creates a file); raises sqlite3.Error."""
    uri = Path(db_path).resolve().as_uri() + "?mode=ro"
    conn = sqlite3.connect(uri, uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def resolve_db(cli_path):
    """Pick the hamdat DB: --db, then $HAMDAT_DB, then DB_DEFAULT if present.

    Returns the validated Path, or None when no path was specified and the
    default doesn't exist (callsign lookup disabled).  A path that is missing
    or can't be opened as a hamdat DB is a fatal error.
    """
    env_path = os.environ.get(DB_ENV, "").strip()
    if cli_path:
        path, source = Path(cli_path).expanduser(), "--db"
    elif env_path:
        path, source = Path(env_path).expanduser(), f"${DB_ENV}"
    elif DB_DEFAULT.exists():
        path, source = DB_DEFAULT, "default location"
    else:
        return None

    if not path.exists():
        sys.exit(f"Error: hamdat database not found: {path} (from {source})")
    try:
        conn = _open_db(path)
        try:
            # Run the real lookup query so a wrong file or schema fails here
            conn.execute(_LOOKUP_SQL, ("",)).fetchone()
        finally:
            conn.close()
    except sqlite3.Error as exc:
        sys.exit(f"Error: cannot open hamdat database {path} (from {source}): {exc}")
    return path


def lookup_callsign(callsign, db_path):
    """Return (name, city, state) from hamdat DB, or (None, None, None).

    db_path comes from resolve_db(); None means lookup is disabled.
    """
    if db_path is None:
        return None, None, None

    try:
        conn = _open_db(db_path)
        try:
            row = conn.execute(_LOOKUP_SQL, (callsign.strip().upper(),)).fetchone()
        finally:
            conn.close()
    except sqlite3.Error as exc:
        sys.exit(f"Error: hamdat database {db_path}: {exc}")

    if not row:
        return None, None, None

    parts = [row["first_name"] or "", row["mi"] or "", row["last_name"] or ""]
    name = " ".join(p.strip().title() for p in parts if p and p.strip())
    if not name:
        name = (row["entity_name"] or "").strip().title()

    city  = (row["city"]  or "").strip().title()
    state = (row["state"] or "").strip().upper()
    return name or None, city or None, state or None


def fit_font(font_path, text, max_h, max_w):
    """Binary-search for the largest point size fitting max_w × max_h."""
    # hi is a search ceiling, not a height estimate: glyph bbox height is
    # typically well under the nominal font size, so capping at max_h alone
    # would stop the search before width-bound text (e.g. short callsigns)
    # reaches its true largest size.
    lo, hi = 8, max(max_h, max_w)
    best = lo
    while lo <= hi:
        mid = (lo + hi) // 2
        f   = ImageFont.truetype(font_path, mid)
        bb  = f.getbbox(text)
        if (bb[2] - bb[0]) <= max_w and (bb[3] - bb[1]) <= max_h:
            best = mid
            lo   = mid + 1
        else:
            hi = mid - 1
    return ImageFont.truetype(font_path, best)


def draw_centered(draw, lw, text, font, y):
    """Draw text horizontally centered at y within width lw. Returns rendered text height."""
    bb = font.getbbox(text)
    x  = (lw - (bb[2] - bb[0])) // 2 - bb[0]
    draw.text((x, y - bb[1]), text, fill="black", font=font)
    return bb[3] - bb[1]


def make_label_image(callsign, name, location, banner=None, note=None,
                     dpi=203, font_path=None, label="4x6"):
    """Render the complete label as a PIL RGB Image in reading orientation.

    Call label_image_to_zpl() to rotate (if needed) and convert for printing.
    """
    cfg = _LABEL_CFG[label]
    lw  = round(cfg["lw_in"]   * dpi)
    lh  = round(cfg["lh_in"]   * dpi)
    mt  = round(cfg["mt"]      * dpi)
    mb  = round(cfg["mb"]      * dpi)
    ms  = round(cfg["ms"]      * dpi)
    div = cfg["div"]
    gap = round(cfg["gap"]     * dpi)
    first_name_h = round(cfg["first_name_h"] * dpi)
    name_h   = round(cfg["name_h"]   * dpi)
    name_gap = round(cfg["name_gap"] * dpi)
    loc_h    = round(cfg["loc_h"]    * dpi)
    note_h   = round(cfg["note_h"]   * dpi)
    call_pad = round(cfg["call_pad"] * dpi)

    first_name, _, rest_name = name.partition(" ")
    rest_name = rest_name.strip()

    img  = Image.new("RGB", (lw, lh), "white")
    draw = ImageDraw.Draw(img)
    draw.rectangle([10, 10, lw - 11, lh - 11], outline="black", width=3)

    def ff(text, max_h, max_w=None):
        return fit_font(font_path, text, max_h, lw - 2 * ms if max_w is None else max_w)

    def dc(text, font, y):
        return draw_centered(draw, lw, text, font, y)

    def draw_divider(y):
        draw.rectangle([ms, y, lw - ms, y + div - 1], fill="black")

    y = mt

    # ── Banner (optional) ─────────────────────────────────────────────────────
    if banner:
        bh = round(cfg["banner_h"] * dpi)
        dc(banner, ff(banner, bh), y)
        y += bh + gap
        draw_divider(y)
        y += div + gap

    # ── Callsign ──────────────────────────────────────────────────────────────
    name_block_h = first_name_h + (name_gap + name_h if rest_name else 0)
    reserved = (
        gap + div + gap
        + name_block_h + gap
        + (loc_h if location else 0)
        + (note_h + gap if note else 0)
        + mb
    )
    call_budget = lh - y - reserved
    f  = ff(callsign, call_budget - call_pad * 2,
            max_w=lw - 2 * ms - call_pad * 2)
    th = dc(callsign, f, y + call_pad)
    y += th + call_pad * 2 + gap

    # ── Divider ───────────────────────────────────────────────────────────────
    draw_divider(y)
    y += div + gap

    # ── Name (first name larger, middle/last name below in the base size) ─────
    dc(first_name, ff(first_name, first_name_h), y)
    y += first_name_h
    if rest_name:
        y += name_gap
        dc(rest_name, ff(rest_name, name_h), y)
        y += name_h
    y += gap

    # ── Location ──────────────────────────────────────────────────────────────
    if location:
        dc(location, ff(location, loc_h), y)

    # ── Note (pinned to bottom) ───────────────────────────────────────────────
    if note:
        note_y = lh - mb - note_h
        dc(note, ff(note, note_h), note_y)

    return img


def _pad_to_byte_width(img):
    """Pad a mode "1" image on the right with white to a width divisible by 8.

    PIL packs each row into whole bytes and fills the unused trailing bits
    with 0, which both TSPL (0 = black) and ZPL (after inversion) print as a
    black bar just past the right edge of the image.
    """
    pad = -img.width % 8
    if not pad:
        return img
    padded = Image.new("1", (img.width + pad, img.height), 1)
    padded.paste(img, (0, 0))
    return padded


def label_image_to_zpl(img, dpi=203, label="4x6"):
    """Convert a PIL label Image to a ZPL string ready to send to the printer."""
    cfg = _LABEL_CFG[label]
    out = img.rotate(-90, expand=True) if cfg["rotate"] else img
    out = _pad_to_byte_width(out.convert("1", dither=Image.Dither.NONE))
    phys_w = round((cfg["lh_in"] if cfg["rotate"] else cfg["lw_in"]) * dpi)
    phys_h = round((cfg["lw_in"] if cfg["rotate"] else cfg["lh_in"]) * dpi)
    rw, _  = out.size
    bytes_per_row = (rw + 7) // 8
    raw      = out.tobytes()
    inverted = bytes(b ^ 0xFF for b in raw)   # PIL white=1 → ZPL 0 (no ink)
    total    = len(inverted)
    hex_data = inverted.hex().upper()
    # Preamble: set Label Top and non-continuous (gap) media tracking before printing.
    # Not saved to NVRAM here (no ^JUS) — that's _send_calibrate's job; writing to
    # NVRAM before every single label wears flash and adds unconfirmed-write latency
    # on the USB single-shot path.
    config = "^XA^LT0^MNY^XZ\n"
    label  = "\n".join([
        "^XA",
        f"^PW{phys_w}",
        f"^LL{phys_h}",
        "^LH0,0",
        f"^FO0,0^GFA,{total},{total},{bytes_per_row},{hex_data}^FS",
        "^XZ",
    ])
    return config + label


def make_blank_zpl(dpi=203, label="4x6"):
    """Return ZPL for an all-white (unprinted) label of the correct size.

    Used by --blankevery to feed a blank separator into long print runs.
    Encoded through the same ^GFA graphic path as a real label (rather than
    a bare ^XA...^XZ) because printers treat a content-less format as a
    settings-only frame and don't advance/print media for it.
    """
    cfg = _LABEL_CFG[label]
    lw = round(cfg["lw_in"] * dpi)
    lh = round(cfg["lh_in"] * dpi)
    blank_img = Image.new("RGB", (lw, lh), "white")
    return label_image_to_zpl(blank_img, dpi, label)


def label_image_to_tspl(img, dpi=203, label="4x6", darkness=12, speed=4,
                        media="gap", gap_mm=3.0, gap_offset_mm=0.0,
                        shift_x_mm=0.0, shift_y_mm=0.0):
    """Convert a PIL label Image to TSPL command bytes ready to send to the printer.

    TSPL (TSC Printer Language) is spoken by the MUNBYN ITPP130B and other
    TSC-compatible thermal printers. Returns bytes rather than str because TSPL's
    BITMAP command embeds the packed 1bpp image data as raw binary in the command
    stream, unlike ZPL's ^GFA which hex-encodes it as text.

    Unlike label_image_to_zpl(), every setting (size, gap, darkness, speed) is
    resent with each label rather than relying on prior NVRAM state — TSPL
    printers keep whatever was last sent, so a self-contained job avoids surprises
    from stale settings left by a previous run.

    shift_x_mm / shift_y_mm move the image in printer orientation (x across the
    print head, y along the feed) for printers whose origin isn't at the label
    edge — e.g. a 108 mm head centred over 4" stock.  Positive values place the
    BITMAP further along +x/+y; negative values trim that leading edge, which
    would otherwise print off the label.  A positive x shift also widens SIZE by
    the same amount: these printers clip at the SIZE width counted from their
    own origin, so the far edge of the label would be cut off (confirmed on the
    MUNBYN ITPP130B).  SIZE height is never changed — it's the label length the
    printer feeds by.
    """
    cfg = _LABEL_CFG[label]
    out = img.rotate(-90, expand=True) if cfg["rotate"] else img
    out = out.convert("1", dither=Image.Dither.NONE)
    dx  = round(shift_x_mm * dpi / 25.4)
    dy  = round(shift_y_mm * dpi / 25.4)
    if dx < 0 or dy < 0:
        out = out.crop((max(0, -dx), max(0, -dy), out.width, out.height))
    out = _pad_to_byte_width(out)
    phys_w_mm = (cfg["lh_in"] if cfg["rotate"] else cfg["lw_in"]) * 25.4
    phys_h_mm = (cfg["lw_in"] if cfg["rotate"] else cfg["lh_in"]) * 25.4
    size_w_mm = phys_w_mm + max(0, dx) * 25.4 / dpi
    rw, rh = out.size
    bytes_per_row = (rw + 7) // 8
    # PIL's mode "1" packing (1=white, 0=black) already matches TSPL's BITMAP
    # wire convention — no bit inversion needed here (unlike the ZPL path).
    bitmap = out.tobytes()

    if media == "continuous":
        media_line = "GAP 0,0\r\n"
    elif media == "bline":
        media_line = f"BLINE {gap_mm:g} mm,{gap_offset_mm:g} mm\r\n"
    else:
        media_line = f"GAP {gap_mm:g} mm,{gap_offset_mm:g} mm\r\n"

    header = (
        f"SIZE {size_w_mm:.2f} mm,{phys_h_mm:.2f} mm\r\n"
        + media_line
        + "REFERENCE 0,0\r\n"
          "OFFSET 0 mm\r\n"
          f"DENSITY {darkness}\r\n"
          f"SPEED {speed}\r\n"
          "DIRECTION 0,0\r\n"
          "CLS\r\n"
    ).encode()
    bitmap_cmd = f"BITMAP {max(0, dx)},{max(0, dy)},{bytes_per_row},{rh},0,".encode() + bitmap
    footer = b"\r\nPRINT 1,1\r\n"
    return header + bitmap_cmd + footer


def make_blank_tspl(dpi=203, label="4x6", darkness=12, speed=4,
                    media="gap", gap_mm=3.0, gap_offset_mm=0.0):
    """Return TSPL for an all-white (unprinted) label of the correct size.

    Used by --blankevery to feed a blank separator into long print runs.
    """
    cfg = _LABEL_CFG[label]
    lw = round(cfg["lw_in"] * dpi)
    lh = round(cfg["lh_in"] * dpi)
    blank_img = Image.new("RGB", (lw, lh), "white")
    return label_image_to_tspl(blank_img, dpi, label, darkness, speed,
                               media, gap_mm, gap_offset_mm)


def make_ruler_image(dpi=203, font_path=None, label="4x6", shift_x_mm=0.0, shift_y_mm=0.0):
    """Render the --ruler printer-alignment test label.

    Drawn in printer orientation (x across the print head, y along the feed),
    matching --shift-x-mm/--shift-y-mm: a label-edge outline plus 1 mm ticks
    along every edge (longer at 5 mm, numbered every 10 mm) counted from 0 at
    the label edge, so one print shows how far off the printer's origin is.
    Returned in reading orientation like make_label_image(), so the encoders'
    usual 4x6 rotation lands it back in printer orientation.
    """
    cfg  = _LABEL_CFG[label]
    pw   = round((cfg["lh_in"] if cfg["rotate"] else cfg["lw_in"]) * dpi)
    ph   = round((cfg["lw_in"] if cfg["rotate"] else cfg["lh_in"]) * dpi)
    dpmm = dpi / 25.4

    img  = Image.new("RGB", (pw, ph), "white")
    draw = ImageDraw.Draw(img)
    draw.rectangle([0, 0, pw - 1, ph - 1], outline="black", width=2)

    num_font = fit_font(font_path, "000", round(1.8 * dpmm), round(5 * dpmm))
    num_gap  = round(0.5 * dpmm)
    num_edge = round(7 * dpmm)   # skip numbers this close to a perpendicular ruler

    def numbered(mm, pos, span):
        return mm % 10 == 0 and num_edge <= pos <= span - num_edge

    def tick_len(mm):
        return round((4.0 if mm % 10 == 0 else 2.5 if mm % 5 == 0 else 1.2) * dpmm)

    for mm in range(int(pw / dpmm) + 1):          # x rulers: top and bottom edges
        x, t = round(mm * dpmm), tick_len(mm)
        draw.line([x, 0, x, t], fill="black", width=2)
        draw.line([x, ph - 1 - t, x, ph - 1], fill="black", width=2)
        if numbered(mm, x, pw):
            draw.text((x, t + num_gap), str(mm), fill="black", font=num_font, anchor="mt")
            draw.text((x, ph - 1 - t - num_gap), str(mm), fill="black", font=num_font, anchor="mb")

    for mm in range(int(ph / dpmm) + 1):          # y rulers: left and right edges
        y, t = round(mm * dpmm), tick_len(mm)
        draw.line([0, y, t, y], fill="black", width=2)
        draw.line([pw - 1 - t, y, pw - 1, y], fill="black", width=2)
        if numbered(mm, y, ph):
            draw.text((t + num_gap, y), str(mm), fill="black", font=num_font, anchor="lm")
            draw.text((pw - 1 - t - num_gap, y), str(mm), fill="black", font=num_font, anchor="rm")

    lines = [
        "HAMTAG ALIGNMENT RULER",
        f"{label} label, {dpi} dpi, shift x {shift_x_mm:+g} mm, y {shift_y_mm:+g} mm",
        "The 0 mm tick of every ruler should sit on the label edge.",
        "Left/top ticks cut off: raise --shift-x-mm/--shift-y-mm by",
        "the first visible mm. Gap before the 0 tick: lower them.",
    ]
    margin = round(9 * dpmm)
    line_h = int((ph - 2 * margin) / (len(lines) * 1.5))
    size   = min(fit_font(font_path, ln, line_h, pw - 2 * margin).size for ln in lines)
    font   = ImageFont.truetype(font_path, size)
    step   = round(size * 1.5)
    y      = (ph - step * len(lines)) // 2
    for ln in lines:
        draw_centered(draw, pw, ln, font, y)
        y += step

    return img.rotate(90, expand=True) if cfg["rotate"] else img


def load_jokes(path):
    """Load one joke per row from a single-column CSV (header + text rows)."""
    jokes = []
    try:
        with open(path, newline="", encoding="utf-8-sig") as f:
            reader = csv.reader(f)
            next(reader, None)  # header row
            for row in reader:
                if row and row[0].strip():
                    jokes.append(row[0].strip())
    except FileNotFoundError:
        sys.exit(f"Jokes file not found: {path}")
    if not jokes:
        sys.exit(f"No jokes found in {path}")
    return jokes


def load_note_lookup(path):
    """Load a --note-lookup roster CSV into {CALLSIGN: note}.

    One "callsign, note" row per line; everything after the first comma is the
    note, so unquoted commas are fine (quoted CSV fields work too).  Callsigns
    match case-insensitively.  Blank lines, '#' comments and a leading
    callsign/call header row are skipped.  A row with no note warns and that
    callsign falls back to --note; a repeated callsign warns and the last row wins.
    """
    notes, seen = {}, {}
    try:
        with open(path, newline="", encoding="utf-8-sig") as f:
            reader = csv.reader(f, skipinitialspace=True)
            for row in reader:
                cells = [c.strip() for c in row]
                if not cells or not cells[0] or cells[0].startswith("#"):
                    continue
                call, line = cells[0].upper(), reader.line_num
                if not seen and call in ("CALLSIGN", "CALL"):
                    continue
                if call in seen:
                    print(f"Warning: {path}:{line}: {call} already listed on line {seen[call]}; "
                          f"using line {line}", file=sys.stderr)
                seen[call] = line
                note = ", ".join(c for c in cells[1:] if c)
                if note:
                    notes[call] = note
                else:
                    notes.pop(call, None)
                    print(f"Warning: {path}:{line}: {call} has no note; --note will be used",
                          file=sys.stderr)
    except (OSError, UnicodeDecodeError, csv.Error) as exc:
        sys.exit(f"Error: cannot read note lookup file {path}: {exc}")
    if not notes:
        sys.exit(f"No callsign notes found in {path}")
    return notes


def _attendance_key(callsign, name):
    """Dedup key: the callsign if there is one, else the name (non-ham guests)."""
    callsign = (callsign or "").strip().upper()
    if callsign:
        return ("call", callsign)
    return ("name", " ".join((name or "").split()).casefold())


def load_attendance(path):
    """Load an --attendance CSV into an ordered {key: (CALLSIGN, name)}, oldest first.

    A missing file is an empty list.  Blank rows and a callsign/name header are
    skipped; a repeated person keeps only the last row.  Raises OSError/csv.Error.
    """
    people = {}
    try:
        f = open(path, newline="", encoding="utf-8-sig")
    except FileNotFoundError:
        return people
    with f:
        for row in csv.reader(f):
            cells = [c.strip() for c in row] + ["", ""]
            call, name = cells[0].upper(), cells[1]
            if not (call or name) or (call == "CALLSIGN" and name.lower() == "name"):
                continue
            key = _attendance_key(call, name)
            people.pop(key, None)
            people[key] = (call, name)
    return people


def save_attendance(path, people):
    """Crash-safely write {key: (callsign, name)} to the --attendance CSV.

    Writes FILE.new and fsyncs it, copies the current FILE to FILE.old, then
    atomically renames FILE.new over FILE and fsyncs the directory.  FILE is
    never missing or partial; FILE.old is the previous save.
    """
    path = Path(path)
    new = path.with_name(path.name + ".new")
    with open(new, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["callsign", "name"])
        writer.writerows(people.values())
        f.flush()
        os.fsync(f.fileno())
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".old"))
    os.replace(new, path)
    dir_fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def record_attendance(path, callsign, name):
    """Re-read the attendance file, move this person to the end, write it back.

    Returns the number of people on the list.
    """
    people = load_attendance(path)
    callsign, name = (callsign or "").strip().upper(), (name or "").strip()
    key = _attendance_key(callsign, name)
    people.pop(key, None)
    people[key] = (callsign, name)
    save_attendance(path, people)
    return len(people)


def note_for(callsign, notes, default):
    """Roster note for callsign from --note-lookup, else the --note default."""
    if notes and callsign:
        return notes.get(callsign.strip().upper(), default)
    return default


def _wrap_text_block(text, font_path, target_aspect=2.0, working_size=60):
    """Render word-wrapped text as a tightly-cropped block at a fixed font size.

    Line-wrap width is chosen so the wrapped block roughly matches
    target_aspect (width/height) for whatever destination it's headed to —
    e.g. a wide, flat area (like a one-line attribution strip) wants few/no
    wraps, while a squarish area can take several lines. Getting this right
    here matters because the caller scales the block to fit its space along
    whichever dimension is tighter: a block shaped nothing like its
    destination gets scaled down by the mismatched dimension and ends up
    smaller than it needs to be, even though the text would easily fit.
    """
    # Empirically fit (via _wrap_joke_block's original tuning: wrap_chars =
    # 3.0*sqrt(len) targeted a 2:1 block), then generalized to any aspect.
    wrap_chars = max(10, min(80, round((4.5 * target_aspect) ** 0.5 * len(text) ** 0.5)))
    font = ImageFont.truetype(font_path, working_size)
    text = "\n".join(textwrap.wrap(text, width=wrap_chars))
    spacing = round(working_size * 0.35)

    probe = ImageDraw.Draw(Image.new("L", (1, 1)))
    bbox = probe.multiline_textbbox((0, 0), text, font=font, spacing=spacing, align="center")
    w, h = round(bbox[2] - bbox[0]), round(bbox[3] - bbox[1])

    block = Image.new("RGB", (w, h), "white")
    ImageDraw.Draw(block).multiline_text(
        (-bbox[0], -bbox[1]), text, fill="black", font=font, spacing=spacing, align="center",
    )
    return block


def make_joke_image(joke, jokenote=None, dpi=203, font_path=None, label="4x6"):
    """Render a joke as a full label image: wrapped text scaled to fit the
    label, with an optional small attribution line pinned to the bottom.
    """
    cfg = _LABEL_CFG[label]
    lw = round(cfg["lw_in"] * dpi)
    lh = round(cfg["lh_in"] * dpi)
    mt = round(cfg["mt"] * dpi)
    mb = round(cfg["mb"] * dpi)
    ms = round(cfg["ms"] * dpi)
    gap = round(cfg["gap"] * dpi)
    # 2x the badge's --note size — the jokenote reads better bigger, and
    # wraps across lines (below) rather than being squeezed onto one.
    jokenote_h = round(cfg["note_h"] * 2.0 * dpi)

    img = Image.new("RGB", (lw, lh), "white")
    draw = ImageDraw.Draw(img)
    draw.rectangle([10, 10, lw - 11, lh - 11], outline="black", width=3)

    note_block_h = (jokenote_h + gap) if jokenote else 0
    area_w = lw - 2 * ms
    area_h = lh - mt - mb - note_block_h

    def _fit_block(text, max_w, max_h):
        block = _wrap_text_block(text, font_path, target_aspect=max_w / max_h)
        scale = min(max_w / block.width, max_h / block.height)
        new_w = max(1, round(block.width * scale))
        new_h = max(1, round(block.height * scale))
        return block.resize((new_w, new_h), Image.LANCZOS)

    block = _fit_block(joke, area_w, area_h)
    img.paste(block, ((lw - block.width) // 2, mt + (area_h - block.height) // 2))

    if jokenote:
        note_block = _fit_block(jokenote, area_w, jokenote_h)
        note_y = lh - mb - jokenote_h + (jokenote_h - note_block.height) // 2
        img.paste(note_block, ((lw - note_block.width) // 2, note_y))

    return img


def _is_network_printer(target):
    """Return True if target looks like a hostname or IP rather than a device path."""
    return not str(target).startswith("/")


def _send_to_printer(data, target, timeout=30):
    """Send label data to a USB device path or a network printer (host[:port], default port 9100).

    data may be str (ZPL) or bytes (TSPL, which embeds raw binary bitmap data).
    """
    payload = data if isinstance(data, bytes) else data.encode()
    if _is_network_printer(target):
        target = str(target)
        if ":" in target:
            host, port = target.rsplit(":", 1)
            port = int(port)
        else:
            host, port = target, 9100
        with socket.create_connection((host, port), timeout=timeout) as sock:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            sock.sendall(payload)
            sock.shutdown(socket.SHUT_WR)
    else:
        with open(target, "wb") as f:
            f.write(payload)


_CALIBRATE_CONFIG_ZPL = (
    "^XA"
    "^MNY"     # non-continuous, web (gap) sensing (N would mean continuous media!)
    "^LT0"     # reset label-top offset
    "^TA000"   # reset tear-off adjust
    "^JUS"     # save to NVRAM
    "^XZ"
)

# USB path: single-shot send (no bidirectional comms on /dev/usb/lp*)
_CALIBRATE_ZPL = _CALIBRATE_CONFIG_ZPL + "~JC"

# AUTODETECT (no args) feeds a few labels and senses paper/gap size in one shot —
# TSPL keeps no separate "save to NVRAM" step the way ZPL's ^JUS does, so unlike
# _send_calibrate's ZPL path this needs no multi-step ~HS handshake either.
_CALIBRATE_TSPL = b"AUTODETECT\r\n"


def _recv_hs(sock):
    """Read the three-line ~HS host-status response from an open printer socket."""
    buf = b""
    while buf.count(b"\x03") < 3:
        chunk = sock.recv(256)
        if not chunk:
            break
        buf += chunk
    return buf.decode("ascii", errors="replace")


def _send_calibrate(target, lang="zpl", timeout=30):
    """Push non-continuous media settings to NVRAM then run optical calibration (~JC).

    Network printers: uses ~HS status polling between steps so the printer has time
    to finish each operation (especially the NVRAM write) before the next command arrives.
    USB printers: single-shot write (no bidirectional comms available on the device node).

    TSPL printers (lang="tspl") use AUTODETECT instead, which is a single self-contained
    command on both USB and network targets — see _CALIBRATE_TSPL.
    """
    if lang == "tspl":
        _send_to_printer(_CALIBRATE_TSPL, target, timeout=timeout)
        return
    if _is_network_printer(target):
        target = str(target)
        host, port = (target.rsplit(":", 1) if ":" in target else (target, 9100))
        port = int(port)
        with socket.create_connection((host, port), timeout=timeout) as sock:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            sock.sendall(b"~HS\n")                         # confirm printer is ready
            _recv_hs(sock)
            sock.sendall(_CALIBRATE_CONFIG_ZPL.encode())   # push settings to NVRAM
            sock.sendall(b"~HS\n")                         # wait for NVRAM write to settle
            _recv_hs(sock)
            sock.sendall(b"~JC\n")                         # trigger calibration cycle
            sock.shutdown(socket.SHUT_WR)
    else:
        _send_to_printer(_CALIBRATE_ZPL, target, timeout=timeout)


def make_encoder(args):
    """Return (render, blank_label, join_blocks) for the printer language.

    render(pil_img) converts a label image to printer data, blank_label()
    makes one unprinted label, and join_blocks(list) combines rendered labels
    into a single payload.
    """
    if args.lang == "tspl":
        def render(pil_img):
            return label_image_to_tspl(pil_img, args.dpi, args.label, args.darkness, args.speed,
                                       args.media, args.gap_mm, args.gap_offset_mm,
                                       args.shift_x_mm, args.shift_y_mm)
        def blank_label():
            return make_blank_tspl(args.dpi, args.label, args.darkness, args.speed,
                                   args.media, args.gap_mm, args.gap_offset_mm)
        return render, blank_label, b"".join

    def render(pil_img):
        return label_image_to_zpl(pil_img, args.dpi, args.label)
    def blank_label():
        return make_blank_zpl(args.dpi, args.label)
    return render, blank_label, "\n".join


def badge_blocks(badge_data, copies, render, jokes=None, jokenote=None,
                 dpi=203, font_path=None, label="4x6"):
    """Rendered labels for one badge in print order.

    Each of the `copies` badge labels is preceded by a freshly chosen random
    joke label when `jokes` is loaded.  Shared by CLI and GUI printing.
    """
    blocks = []
    for _ in range(copies):
        if jokes:
            joke_img = make_joke_image(
                random.choice(jokes), jokenote=jokenote,
                dpi=dpi, font_path=font_path, label=label,
            )
            blocks.append(render(joke_img))
        blocks.append(badge_data)
    return blocks


def run_gui(args):
    """Launch the interactive tkinter GUI."""
    try:
        import tkinter as tk
        from tkinter import messagebox
        from PIL import ImageTk
    except ImportError as exc:
        sys.exit(f"GUI requires tkinter (usually bundled with Python): {exc}")

    font_path      = find_font(args.font)
    dpi            = args.dpi
    label          = args.label
    printer_device = args.printer or "/dev/usb/lp0"
    jokes          = load_jokes(args.jokes) if args.jokes else None
    render, _, join_blocks = make_encoder(args)
    notes          = load_note_lookup(args.note_lookup) if args.note_lookup else None
    attendance     = args.attendance
    if attendance:
        # Read and rewrite now so a bad path or permissions fail at launch, not mid-event
        try:
            save_attendance(attendance, load_attendance(attendance))
        except (OSError, UnicodeDecodeError, csv.Error) as exc:
            sys.exit(f"Error: cannot read/write attendance file {attendance}: {exc}")

    root = tk.Tk()
    root.title("hamtag — Ham Badge Printer")
    root.resizable(False, False)

    call_var     = tk.StringVar(value=(args.call or "").upper())
    name_var     = tk.StringVar(value=args.name or "")
    location_var = tk.StringVar(value=args.location or "")
    banner_var   = tk.StringVar(value=args.banner or "")
    note_var     = tk.StringVar(value=args.note or "")
    status_var   = tk.StringVar(value="Enter a callsign and press Enter to look up.")

    # Capture initial CLI values so Default button can restore them
    default_banner = args.banner or ""
    default_note   = args.note   or ""

    # ── Layout ────────────────────────────────────────────────────────────────
    outer = tk.Frame(root, padx=10, pady=10)
    outer.pack()

    form_frame = tk.LabelFrame(outer, text="Badge Details", padx=10, pady=10)
    form_frame.grid(row=0, column=0, sticky="nsew", padx=(0, 10))

    prev_frame = tk.LabelFrame(outer, text="Preview", padx=4, pady=4)
    prev_frame.grid(row=0, column=1, sticky="nsew")

    # Scale preview to fit a fixed 609×406 box, preserving label aspect ratio.
    cfg  = _LABEL_CFG[label]
    _scl = min(round(6 * 203 * 0.5) / (cfg["lw_in"] * dpi),
               round(4 * 203 * 0.5) / (cfg["lh_in"] * dpi))
    PW   = round(cfg["lw_in"] * dpi * _scl)
    PH   = round(cfg["lh_in"] * dpi * _scl)
    prev_lbl = tk.Label(prev_frame, width=PW, height=PH, bg="gray80")
    prev_lbl.pack()

    fields_def = [
        ("Banner",   banner_var),
        ("Callsign", call_var),
        ("Name",     name_var),
        ("Location", location_var),
        ("Note",     note_var),
    ]
    entries = {}
    for i, (lbl, var) in enumerate(fields_def):
        tk.Label(form_frame, text=lbl + ":", anchor="e", width=9).grid(
            row=i, column=0, sticky="e", pady=4)
        e = tk.Entry(form_frame, textvariable=var, width=28,
                     font=("TkDefaultFont", 11))
        e.grid(row=i, column=1, sticky="ew", pady=4)
        entries[lbl] = e

    copies_var = tk.StringVar(value=str(max(1, args.copies)))
    copies_row = len(fields_def)
    tk.Label(form_frame, text="Copies:", anchor="e", width=9).grid(
        row=copies_row, column=0, sticky="e", pady=4)
    copies_spin = tk.Spinbox(form_frame, from_=1, to=99, textvariable=copies_var,
                              width=5, font=("TkDefaultFont", 11), justify="left")
    copies_spin.grid(row=copies_row, column=1, sticky="w", pady=4)

    btn_row = tk.Frame(form_frame)
    btn_row.grid(row=copies_row + 1, column=0, columnspan=2, pady=(12, 0))

    lookup_btn    = tk.Button(btn_row, text="Look Up",   width=12)
    lookup_btn.pack(side="left", padx=6)
    print_btn     = tk.Button(btn_row, text="Print It!", width=12, state="disabled")
    print_btn.pack(side="left", padx=6)
    default_btn   = tk.Button(btn_row, text="Default",   width=10)
    default_btn.pack(side="left", padx=6)
    calibrate_btn = tk.Button(btn_row, text="Calibrate", width=10)
    calibrate_btn.pack(side="left", padx=6)

    tk.Label(root, textvariable=status_var, anchor="w",
             relief="sunken", bd=1, padx=6).pack(fill="x", side="bottom")

    # ── Preview ───────────────────────────────────────────────────────────────
    _job   = [None]
    _photo = [None]   # keep reference so GC doesn't collect it

    def refresh_preview():
        cs  = call_var.get().strip().upper() or "CALL"
        nm  = name_var.get().strip() or cs
        loc = location_var.get().strip() or None
        ban = banner_var.get().strip() or None
        nt  = note_var.get().strip() or None
        try:
            pil = make_label_image(cs, nm, loc, ban, nt, dpi, font_path, label)
            pil = pil.resize((PW, PH), Image.LANCZOS)
            _photo[0] = ImageTk.PhotoImage(pil)
            prev_lbl.configure(image=_photo[0])
        except Exception as exc:
            status_var.set(f"Preview error: {exc}")

    def schedule_preview(*_):
        if _job[0]:
            root.after_cancel(_job[0])
        _job[0] = root.after(300, refresh_preview)

    for _, var in fields_def:
        var.trace_add("write", schedule_preview)

    # ── Lookup ────────────────────────────────────────────────────────────────
    _lookup_found = [False]

    def _print_status():
        cs = call_var.get().strip().upper()
        focused = root.focus_get()
        roster = f" · Roster: {notes[cs]}" if notes and cs in notes else ""
        if _lookup_found[0]:
            if focused == print_btn:
                status_var.set(f"{cs} Found in HAMDAT{roster} — press Enter to print.")
            else:
                status_var.set(f"{cs} Found in HAMDAT{roster} — click Print It! to print.")
        elif args.db is None:
            status_var.set(f"No HAMDAT database{roster} — fill in manually.")
        else:
            status_var.set(f"{cs} NOT Found in HAMDAT{roster} — fill in manually.")

    def do_lookup(*_):
        cs = call_var.get().strip().upper()
        if not cs:
            status_var.set("Enter a callsign first.")
            entries["Callsign"].focus_set()
            return
        call_var.set(cs)
        name_var.set("")
        location_var.set("")
        if notes:
            note_var.set(note_for(cs, notes, default_note))
        db_name, db_city, db_state = lookup_callsign(cs, args.db)
        if db_name:
            name_var.set(db_name)
        if db_city or db_state:
            location_var.set(", ".join(p for p in [db_city, db_state] if p))
        _lookup_found[0] = any([db_name, db_city, db_state])
        _print_status()
        print_btn.configure(state="normal")
        print_btn.focus_set()

    # ── Print ─────────────────────────────────────────────────────────────────
    def do_print(*_):
        cs  = call_var.get().strip().upper() or name_var.get().strip()
        nm  = name_var.get().strip() or cs
        loc = location_var.get().strip() or None
        ban = banner_var.get().strip() or None
        nt  = note_var.get().strip() or None
        if not cs:
            status_var.set("Nothing to print.")
            return
        try:
            copies = int(copies_var.get())
            if copies < 1:
                raise ValueError
        except ValueError:
            status_var.set("Copies must be a whole number ≥ 1.")
            return
        try:
            pil = make_label_image(cs, nm, loc, ban, nt, dpi, font_path, label)
            blocks = badge_blocks(render(pil), copies, render, jokes, args.jokenote,
                                  dpi, font_path, label)
        except Exception as exc:
            status_var.set(f"Render error: {exc}")
            return
        if not _is_network_printer(printer_device):
            device = Path(printer_device)
            if not device.exists():
                messagebox.showerror(
                    "Printer not found",
                    f"Device not found: {printer_device}\n"
                    "Is the printer connected and powered on?",
                )
                return
        try:
            _send_to_printer(join_blocks(blocks), printer_device)
        except PermissionError:
            messagebox.showerror(
                "Permission denied",
                f"Cannot write to {printer_device}\n"
                f"Fix with:  sudo usermod -aG lp {os.getlogin()}",
            )
            return
        except OSError as exc:
            messagebox.showerror("Print error", str(exc))
            return
        msg = f"Printed {cs} ×{copies}" if copies > 1 else f"Printed {cs}"
        if jokes:
            msg += f" (+{copies} joke{'s' if copies > 1 else ''})"
        msg += "  ✓"
        if attendance:
            try:
                count = record_attendance(attendance, call_var.get(), name_var.get())
                msg += f"  · Attendance: {count}"
            except (OSError, UnicodeDecodeError, csv.Error) as exc:
                messagebox.showwarning(
                    "Attendance not saved",
                    f"Label printed, but {cs} was not recorded in {attendance}:\n{exc}",
                )
        status_var.set(msg)
        # Reset for next badge — keep banner and note (they're event-level constants),
        # except a --note-lookup roster note, which belongs to this callsign only
        call_var.set("")
        name_var.set("")
        location_var.set("")
        if notes:
            note_var.set(default_note)
        print_btn.configure(state="disabled")
        entries["Callsign"].focus_set()

    # ── Calibrate ─────────────────────────────────────────────────────────────
    def do_calibrate(*_):
        try:
            _send_calibrate(printer_device, lang=args.lang)
            status_var.set("Calibration sent — printer will feed 2-4 labels.")
        except OSError as exc:
            messagebox.showerror("Calibration error", str(exc))

    calibrate_btn.configure(command=do_calibrate)

    # ── Default ───────────────────────────────────────────────────────────────
    def do_default(*_):
        call_var.set("")
        name_var.set("")
        location_var.set("")
        banner_var.set(default_banner)
        note_var.set(default_note)
        copies_var.set(str(max(1, args.copies)))
        print_btn.configure(state="disabled")
        status_var.set("Restored defaults — enter a callsign.")
        entries["Callsign"].focus_set()

    default_btn.configure(command=do_default)

    # ── Key bindings ──────────────────────────────────────────────────────────
    def on_callsign_return(e):
        do_lookup()
        return "break"

    def on_print_return(e):
        do_print()
        return "break"

    entries["Callsign"].bind("<Return>", on_callsign_return)
    print_btn.bind("<Return>", on_print_return)

    print_btn.bind("<FocusIn>",  lambda e: _print_status() if print_btn["state"] == "normal" else None)
    print_btn.bind("<FocusOut>", lambda e: _print_status() if print_btn["state"] == "normal" else None)
    lookup_btn.configure(command=do_lookup)
    print_btn.configure(command=do_print)

    root.bind("<Escape>", do_default)

    entries["Callsign"].focus_set()
    # Trigger an initial lookup if --call was supplied on the command line
    if args.call:
        do_lookup()
    else:
        refresh_preview()

    root.mainloop()


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Generate a ZPL or TSPL name badge label for a thermal printer. "
            "Produces landscape output on standard 4\"×6\" label stock."
        )
    )
    parser.add_argument(
        "--call", metavar="CALLSIGN", nargs="+",
        help="One or more HAM callsigns to look up in the hamdat database "
             "(space- and/or comma-delimited, e.g. --call K2TTA W1AW or --call K2TTA,W1AW)",
    )
    parser.add_argument(
        "--name", metavar="NAME",
        help="Operator name — overrides the database value",
    )
    parser.add_argument(
        "--location", metavar="TEXT",
        help="Location line, e.g. 'Hoboken, NJ' — overrides the database value",
    )
    parser.add_argument(
        "--banner", metavar="TEXT",
        help="Banner text at the top of the badge, e.g. 'HAMFEST VOLUNTEER'",
    )
    parser.add_argument(
        "--note", metavar="TEXT",
        help="Small text pinned to the bottom of the badge "
             "(the default when --note-lookup has no entry for a callsign)",
    )
    parser.add_argument(
        "--note-lookup", metavar="FILE",
        help="CSV roster of 'callsign, note' rows, e.g. 'ke2r, Club President'; a listed "
             "callsign's note replaces --note, which stays the default for everyone else",
    )
    parser.add_argument(
        "--font", metavar="FILE",
        help="TrueType font for all text (auto-detected if omitted; "
             "install fonts-hack for a slashed zero)",
    )
    parser.add_argument(
        "--db", metavar="PATH",
        help=f"hamdat SQLite database path (default: ${DB_ENV} if set, "
             f"else {DB_DEFAULT} if it exists)",
    )
    parser.add_argument(
        "--dpi", type=int, choices=[203, 300], default=203,
        help="Printer DPI — 203 (default) or 300",
    )
    parser.add_argument(
        "--label", choices=["4x6", "4x2"], default="4x6",
        help="Label stock — 4x6 landscape badge (default) or 4x2 portrait",
    )
    parser.add_argument(
        "--output", metavar="FILE",
        help="Write label data to FILE instead of stdout",
    )
    parser.add_argument(
        "--lang", choices=["zpl", "tspl"], default="zpl",
        help="Printer command language — zpl (default, Zebra printers) or "
             "tspl (TSC-compatible printers, e.g. MUNBYN ITPP130B)",
    )
    parser.add_argument(
        "--printer", metavar="TARGET", nargs="?", const="/dev/usb/lp0",
        help="Send label data to a printer — USB device path (default: /dev/usb/lp0) "
             "or network host[:port] (default port 9100), e.g. 192.168.1.100 or printer.local:9100",
    )
    parser.add_argument(
        "--darkness", type=int, default=12, metavar="1-16",
        help="TSPL print darkness, 1 (lightest) to 16 (darkest), default 12 (--lang tspl only)",
    )
    parser.add_argument(
        "--speed", type=int, default=4, metavar="1-8",
        help="TSPL print speed in inches/sec, 1 to 8, default 4 (--lang tspl only)",
    )
    parser.add_argument(
        "--media", choices=["gap", "bline", "continuous"], default="gap",
        help="TSPL media sensing mode — gap (default), bline (black mark), "
             "or continuous stock (--lang tspl only)",
    )
    parser.add_argument(
        "--gap-mm", type=float, default=3.0, metavar="MM",
        help="TSPL gap/black-line height in mm, default 3.0 (--lang tspl only)",
    )
    parser.add_argument(
        "--gap-offset-mm", type=float, default=0.0, metavar="MM",
        help="TSPL gap/black-line offset in mm, default 0.0 (--lang tspl only)",
    )
    parser.add_argument(
        "--shift-x-mm", type=float, default=0.0, metavar="MM",
        help="TSPL: move the printed image across the print head, + right / - left as "
             "the --ruler label reads, default 0.0 (--lang tspl only)",
    )
    parser.add_argument(
        "--shift-y-mm", type=float, default=0.0, metavar="MM",
        help="TSPL: move the printed image along the feed, + down / - up as the "
             "--ruler label reads, default 0.0 (--lang tspl only)",
    )
    parser.add_argument(
        "--copies", type=int, default=1,
        help="Number of copies to print of each badge, sequentially (default: 1)",
    )
    parser.add_argument(
        "--blankevery", type=int, metavar="N",
        help="Print a blank label after every N labels, to mark break points "
             "for stapling a long run into a book",
    )
    parser.add_argument(
        "--jokes", metavar="FILE",
        help="Path to a single-column jokes CSV (header + one joke per row). "
             "Prints a random joke label before every badge printed.",
    )
    parser.add_argument(
        "--jokenote", metavar="TEXT",
        help="Small attribution text pinned to the bottom of each joke label "
             "(requires --jokes)",
    )
    parser.add_argument(
        "--calibrate", action="store_true",
        help="Push non-continuous media settings to NVRAM and run optical label calibration (~JC). Requires --printer.",
    )
    parser.add_argument(
        "--ruler", action="store_true",
        help="Print an alignment test label with mm rulers along every edge, for measuring "
             "--shift-x-mm/--shift-y-mm. Honors --label, --dpi, --lang and the output options.",
    )
    parser.add_argument(
        "--gui", action="store_true",
        help="Launch interactive GUI (other flags pre-fill the form)",
    )
    parser.add_argument(
        "--attendance", metavar="FILE",
        help="GUI only: record callsign,name of each printed badge in this CSV "
             "(one row per person, most recent entry wins)",
    )
    args = parser.parse_args()

    calls = []
    for token in (args.call or []):
        for part in token.replace(",", " ").split():
            cs = part.strip().upper()
            if cs:
                calls.append(cs)
    args.call = calls[0] if calls else None  # single-callsign consumers (GUI) see the first

    if args.copies < 1:
        parser.error("--copies must be at least 1")

    if not (1 <= args.darkness <= 16):
        parser.error("--darkness must be between 1 and 16")

    if not (1 <= args.speed <= 8):
        parser.error("--speed must be between 1 and 8")

    if args.blankevery is not None and args.blankevery < 1:
        parser.error("--blankevery must be at least 1")

    if args.attendance and not args.gui:
        parser.error("--attendance requires --gui")

    if args.jokenote and not args.jokes:
        parser.error("--jokenote requires --jokes")

    for opt in ("shift_x_mm", "shift_y_mm"):
        if not (-25 <= getattr(args, opt) <= 25):
            parser.error(f"--{opt.replace('_', '-')} must be between -25 and 25")

    # ── GUI mode ──────────────────────────────────────────────────────────────
    if args.gui:
        if len(calls) > 1:
            print(f"Note: GUI mode only pre-fills the first callsign ({calls[0]}); "
                  f"the other {len(calls) - 1} were ignored.", file=sys.stderr)
        args.db = resolve_db(args.db)
        run_gui(args)
        return

    # ── Calibrate mode ────────────────────────────────────────────────────────
    if args.calibrate:
        if not args.printer:
            parser.error("--calibrate requires --printer")
        try:
            _send_calibrate(args.printer, lang=args.lang)
            print(f"Calibration sent to {args.printer} — printer will feed 2-4 labels.", file=sys.stderr)
        except OSError as exc:
            sys.exit(f"Error: {exc}")
        return

    # ── CLI mode ──────────────────────────────────────────────────────────────
    if args.ruler and (calls or args.name):
        parser.error("--ruler prints a standalone test label; don't combine it with --call/--name")

    if not calls and not args.name and not args.ruler:
        parser.error("--call and/or --name is required (or use --gui or --ruler)")

    if len(calls) > 1 and (args.name or args.location):
        parser.error("--name/--location cannot be combined with multiple --call values")

    args.db = resolve_db(args.db)
    if calls and args.db is None:
        print(f"Note: no hamdat database at {DB_DEFAULT} (and ${DB_ENV} not set) — "
              "callsign lookup disabled.", file=sys.stderr)

    font_path = find_font(args.font)
    # None → single manual badge from --name; --ruler prints only the test label
    entries   = [] if args.ruler else (calls if calls else [None])
    jokes     = load_jokes(args.jokes) if args.jokes else None
    notes     = load_note_lookup(args.note_lookup) if args.note_lookup else None

    render, blank_label, join_blocks = make_encoder(args)

    blocks = []
    if args.ruler:
        sx, sy = (args.shift_x_mm, args.shift_y_mm) if args.lang == "tspl" else (0.0, 0.0)
        blocks.append(render(make_ruler_image(args.dpi, font_path, args.label, sx, sy)))
    for callsign in entries:
        name     = args.name
        location = args.location

        if callsign and args.db is not None:
            db_name, db_city, db_state = lookup_callsign(callsign, args.db)
            if not name and db_name:
                name = db_name
            if not location and (db_city or db_state):
                location = ", ".join(p for p in [db_city, db_state] if p)
            if not any([db_name, db_city, db_state]):
                print(f"Warning: {callsign} not found in database", file=sys.stderr)

        if not name:
            name = callsign or "(unknown)"

        display_call = callsign if callsign else name

        img = make_label_image(
            display_call, name, location,
            banner=args.banner,
            note=note_for(callsign, notes, args.note),
            dpi=args.dpi,
            font_path=font_path,
            label=args.label,
        )
        blocks.extend(badge_blocks(render(img), args.copies, render, jokes, args.jokenote,
                                   args.dpi, font_path, args.label))

    if args.blankevery:
        blank_data = blank_label()
        spaced_blocks = []
        for i, data in enumerate(blocks, start=1):
            spaced_blocks.append(data)
            if i % args.blankevery == 0:
                spaced_blocks.append(blank_data)
        # Always end the run on a blank label, even if the count didn't land
        # on one, so the last badge in the stack is never left exposed.
        if not spaced_blocks or spaced_blocks[-1] != blank_data:
            spaced_blocks.append(blank_data)
        blocks = spaced_blocks

    all_data = join_blocks(blocks)

    if args.output:
        if isinstance(all_data, bytes):
            Path(args.output).write_bytes(all_data)
        else:
            Path(args.output).write_text(all_data)
        print(f"Label data written to {args.output}", file=sys.stderr)

    if args.printer:
        target = args.printer
        if not _is_network_printer(target):
            device = Path(target)
            if not device.exists():
                sys.exit(
                    f"Printer device not found: {target}\n"
                    "Check that the printer is connected and powered on.\n"
                    "You may need: sudo chmod a+rw /dev/usb/lp0"
                )
        try:
            _send_to_printer(all_data, target)
            print(f"Sent to {target}", file=sys.stderr)
        except PermissionError:
            sys.exit(
                f"Permission denied: {target}\n"
                f"Fix with:  sudo usermod -aG lp {os.getlogin()}\n"
                "Then log out and back in, or run:  sudo chmod a+rw /dev/usb/lp0"
            )
        except OSError as exc:
            sys.exit(f"Error sending to printer: {exc}")

    if not args.output and not args.printer:
        if isinstance(all_data, bytes):
            sys.stdout.buffer.write(all_data)
        else:
            print(all_data)


if __name__ == "__main__":
    main()
